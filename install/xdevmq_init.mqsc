STOP LISTENER('SYSTEM.DEFAULT.LISTENER.TCP') IGNSTATE(YES)

* LOCAL QUEUES
DEFINE QLOCAL ('DEV.QUEUE.1') REPLACE
DEFINE QLOCAL ('DEV.QUEUE.2') REPLACE
DEFINE QLOCAL ('DEV.QUEUE.3') REPLACE

* Dead Letter Queue
DEFINE QLOCAL ('DEV.DEAD.LETTER.QUEUE') REPLACE
ALTER QMGR DEADQ('DEV.DEAD.LETTER.QUEUE')

ALTER QMGR CONNAUTH(DEV.AUTHINFO)
DEFINE AUTHINFO(DEV.AUTHINFO) AUTHTYPE(IDPWOS) ADOPTCTX(YES) CHCKCLNT(NONE) CHCKLOCL(NONE) FAILDLAY(1) AUTHENMD(OS)

* Server Connection
DEFINE CHANNEL ('XDEVMQ.SVRCONN') CHLTYPE(SVRCONN) MCAUSER('app') DESCR('Channel for use by sample programs') REPLACE

SET CHLAUTH('XDEVMQ.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('*') USERSRC(CHANNEL) DESCR('Allows connection via APP channel') ACTION(REPLACE)
SET AUTHREC OBJTYPE(QMGR) PRINCIPAL('app') AUTHADD(CONNECT,INQ)
SET AUTHREC PROFILE('DEV.**') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(PUT,GET,INQ,BROWSE)

* Listener
DEFINE LISTENER('LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('LISTENER.TCP') IGNSTATE(YES)

* Security
ALTER QMGR AUTHOREV(ENABLED)